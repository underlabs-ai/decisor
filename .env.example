# SGLang with loader and logprobs fixes.
SGLANG_IMAGE=decisor-sglang:0.5.20
# Local path overrides the Hugging Face repository.
SGLANG_MODEL_REPO=underlabs/decisor-4b
SGLANG_MODEL_PATH=
SGLANG_GPU_DEVICE=0
SGLANG_PORT=8768
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SGLANG_API_KEY=
# Weights + KV cache fraction; runtime needs extra VRAM.
# Lower on shared GPUs; too low may prevent loading.
SGLANG_MEM_FRACTION=0.80
# keep the quotes: the value contains spaces
SGLANG_EXTRA_ARGS="--cuda-graph-backend-prefill=disabled --disable-radix-cache"
